{
  "name": "ot-manager",
  "version": "1.0.5",
  "description": "Ứng dụng quản lý tăng ca - OT Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [
    "overtime",
    "management",
    "ot"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^24.13.3",
    "localtunnel": "^2.0.2"
  },
  "build": {
    "appId": "com.example.otmanager",
    "icon": "resources/icon.png",
    "compression": "normal",
    "files": [
      "**/*",
      "!android-sdk/**",
      "!temp_jdk/**",
      "!node-portable/**",
      "!dist/**",
      "!mobile-android/**",
      "!OT-Manager-mobile.apk",
      "!.git/**",
      "!.vscode/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "directories": {
      "output": "dist"
    }
  }
}

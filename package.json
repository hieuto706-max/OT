{
  "name": "ot-manager",
  "version": "1.5.8",
  "description": "Ứng dụng quản lý tăng ca - OT Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/clean-dist.js",
    "build": "electron-builder --win --publish always",
    "build-local": "node scripts/clean-dist.js && electron-builder --win --publish never",
    "release": "node scripts/build-and-release.js"
  },
  "keywords": [
    "overtime",
    "management",
    "ot"
  ],
  "author": "OT Manager",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "acme-client": "^5.3.0",
    "firebase-admin": "^12.0.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.22.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.4.3",
    "localtunnel": "^2.0.2"
  },
  "build": {
    "appId": "com.hieuto.otmanager",
    "copyright": "Copyright © 2026 OT Manager",
    "icon": "resources/icon.png",
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "hieuto706-max",
        "repo": "OT",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!android-sdk/**",
      "!temp_jdk/**",
      "!node-portable/**",
      "!dist/**",
      "!mobile-android/**",
      "!mobile-ios/**",
      "!OT-Manager-mobile.apk",
      "!.git/**",
      "!.vscode/**",
      "!docs/**",
      "!server/config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "publisherName": "OT Manager",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "dist"
    }
  }
}

# ==========================================
# OT Manager - Biến Môi Trường (Environment Variables)
# ==========================================
# Copy file này thành .env và điền giá trị thực tế.
# File .env KHÔNG được commit lên Git.

# --- Bảo mật ---
# Khóa bí mật dùng để ký JWT Token (bắt buộc đặt cố định cho môi trường Production)
# Nếu không đặt, hệ thống sẽ tự sinh khóa ngẫu nhiên mỗi lần khởi động (phiên cũ sẽ mất hiệu lực)
JWT_SECRET=your-secret-key-here

# --- GPS Validation ---
# Tọa độ văn phòng/công ty (dùng để đối chiếu vị trí, không chặn nhân viên)
OFFICE_LAT=0
OFFICE_LON=0
# Bán kính cho phép tính là "gần văn phòng" (mét)
ALLOWED_RADIUS_METERS=200

# --- CORS ---
# Danh sách domain được phép truy cập API (cách nhau bởi dấu phẩy)
# Để trống = cho phép tất cả (backward compatible)
# ALLOWED_ORIGINS=https://your-domain.com,https://otmanager.id.vn

# --- GitHub Gist (Lưu trữ dữ liệu đám mây) ---
# GIST_ID=your-gist-id
# GITHUB_TOKEN=your-github-token

# --- Mã hóa Database (AES-256-CBC) ---
# Khóa mã hóa dữ liệu trước khi đẩy lên Gist (32 ký tự hex)
# DB_ENCRYPTION_KEY=your-32-char-hex-encryption-key

# --- Tự động gia hạn SSL Let's Encrypt (Dành cho ký số iOS profile) ---
# Tên miền chính để tự động xin chứng chỉ (VD: otmanager.id.vn)
# SSL_DOMAIN=otmanager.id.vn
# Email đăng ký Let's Encrypt để nhận cảnh báo (VD: admin@your-domain.com)
# SSL_EMAIL=admin@your-domain.com
# Sử dụng môi trường thử nghiệm Staging (true/false, mặc định false)
# SSL_USE_STAGING=false

# --- Cấu hình Gửi Email SMTP (Xác thực & OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="OT Manager" <noreply@otmanager.id.vn>
